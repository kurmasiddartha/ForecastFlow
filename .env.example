# Application Configuration
APP_NAME=ForecastFlow API
APP_ENV=production
APP_DEBUG=false
API_V1_STR=/api/v1

# Authentication & Security
JWT_SECRET_KEY=change_me_to_a_secure_random_hex_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# MongoDB Atlas Connection
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=forecastflow
MONGODB_MIN_POOL_SIZE=1
MONGODB_MAX_POOL_SIZE=20
MONGODB_TIMEOUT_MS=10000

# CORS Configuration
CORS_ORIGINS=["*"]
