# Application Configuration
APP_NAME=ForecastFlow API
APP_ENV=development
APP_DEBUG=true
API_V1_STR=/api/v1

# Server Settings
HOST=0.0.0.0
PORT=8000

# Authentication & Security
JWT_SECRET_KEY=forecastflow_super_secret_development_key_change_in_production_12345
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# MongoDB Atlas Connection
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=forecastflow_db
MONGODB_MIN_POOL_SIZE=5
MONGODB_MAX_POOL_SIZE=50
MONGODB_TIMEOUT_MS=5000

# CORS Configuration (Comma-separated list or JSON array)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
